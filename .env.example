# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password

# LLM Configuration (Transformers)
LLM_MODEL=google/gemma-4-E2B-it
LLM_DEVICE=auto
LLM_MAX_LENGTH=2048
LLM_TEMPERATURE=0.7

# Application Configuration
DEBUG=false
TOP_K=5
DIALECT=postgresql
